{
  "name": "debate_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "start:migrate": "npm run db:migrate && next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "spike:sources": "tsx --conditions=react-server scripts/spike-sources.ts",
    "smoke": "DEBATE_DATA_DIR=./data/smoke tsx --conditions=react-server scripts/smoke-pipeline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.12.0",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
